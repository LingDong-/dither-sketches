pg := drw.create_graphics(W,H);
pg.begin();
drw.fill(...color1);
drw.stroke(...color0);
drw.stroke_weight(1.5);
for (i := 0; i < ends.length(); i++){
  if (ends[i]<0) continue;
  drw.push_matrix();
  p0 := corner_xs[paths[i][paths[i].length()-1]];
  p1 := sites[ends[i]];
  drw.translate(...sites[ends[i]])
  drw.rotate_deg(math.atan2(...((p1-p0).yx))*180.0/math.PI);
  drw.scale(0.9,0.9);
  drw.ellipse( 2,0, 16,14 );
  drw.ellipse( 4,-2, 20,14 );
  
  drw.pop_matrix();
} 

for (i := 0; i < leaves.length(); i++){
  drw.begin_shape();
  for (j := 0; j < leaves[i].length(); j++){
    drw.vertex(...leaves[i][j]);
  }
  drw.end_shape(1);
}
drw.stroke(...color0);
drw.stroke_weight(1.5);
drw.no_fill();
for (i := 0; i < veins.length(); i++){
  drw.begin_shape();
  for (j := 0; j < veins[i].length(); j++){
    drw.vertex(...veins[i][j])
  }
  drw.end_shape();
}

drw.no_fill();
drw.stroke(...color0)
drw.stroke_weight(5);
for (k := 0; k < vines.length(); k++){
  drw.begin_shape();
  for (i := 0; i < vines[k].length(); i++){
    drw.vertex(...vines[k][i])
  }
  drw.end_shape();
} 
drw.stroke(...color2)
drw.stroke_weight(2);
for (k := 0; k < vines.length(); k++){
  drw.begin_shape();
  for (i := 0; i < vines[k].length(); i++){
    drw.vertex(...vines[k][i])
  }
  drw.end_shape();
}

drw.stroke(...color0);
drw.stroke_weight(1.5);
drw.fill(...color3);
for (i := 0; i < flowers.length(); i++){
  drw.begin_shape();
  for (j := 0; j < flowers[i].length(); j++){
    drw.vertex(...flowers[i][j])
  }
  drw.end_shape();
}


pg.end();


while (1){
  drw.background(...color0);
  pg.draw(0,0);
  drw.poll();
}

