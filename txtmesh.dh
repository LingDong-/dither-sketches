include "std/font"
include "std/io"
include "std/frag"
include "std/rdr"
include "std/str"
include "std/list"
include "std/vec"
include "std/geom"
include "std/math"
include "std/win"
include "std/time"

bytes := io.read_file("../dither-lang/examples/assets/caslon.ttf");
tf := font.decode(bytes);


func bridge(land:list[vec[f32,2]],hole:list[vec[f32,2]]):list[vec[f32,2]]{
  cands := list[tup[f32,i32,i32]]{};
  for (i := 0; i < land.length(); i++){
    for (j := 0; j < hole.length(); j++){
      cands.push([(land[i]-hole[j]).mag(),i,j])
    }
  }
  cands.sort(func(a:tup[f32,i32,i32]):f32{
    return a[0];
  });

  either := list[]{land,hole};
  
  for (k := 0; k < cands.length(); k++){
    [d,i0,i1] := cands[k];
    ok := 1;
    for (i := 0; i < either.length(); i++){
      for (j := 0; j < either[i].length(); j++){
        j1 := (j+1)%either[i].length();
        if (i == 0 && (i0 == j || i0 == j1)) continue;
        if (i == 1 && (i1 == j || i1 == j1)) continue;

        [b,v] := geom.line_intersect(
          either[i][j],either[i][j1],
          land[i0],hole[i1],
          geom.LHS_SEGMENT|geom.RHS_SEGMENT
        );
        if (b){
          ok = 0;
          break;
        }
      }
      if (!ok) break;
    }
    if (ok){
      return land.slice(0,i0+1).concat(
        hole.slice(i1,hole.length())
      ).concat(
        hole.slice(0,i1+1)
      ).concat(
        land.slice(i0,land.length())
      )
    }
  }
  io.println("[warn] bridge failed");
  return land.concat(hole);
}

func no_repeat_ends(p:list[vec[f32,2]]){
  if (p[0] == p[p.length()-1]){
    p.pop();
  }
}

func poly_area(points:list[vec[f32,2]]):f32{
  n := points.length();
  a := 0.0;
  p := n-1;
  for (q:=0; q<n; q++){
    a += points[p].x*points[q].y - points[q].x*points[p].y;
    p = q;
  }
  return a*0.5;
}

func unhole(ps:list[list[vec[f32,2]]]):list[list[vec[f32,2]]]{
  lands := list[list[vec[f32,2]]]{};
  for (i := 0; i < ps.length(); i++) no_repeat_ends(ps[i]);
  for (i := 0; i < ps.length(); i++){
    if (poly_area(ps[i])>0){
      lands.push(ps[i]);
    }else if (ps[i].length()){
      ok := 0;
      for (j := 0; j < lands.length(); j++){
        if (geom.pt_in_poly(ps[i][0], lands[j])){
          lands[j] = bridge(lands[j], ps[i]);
          ok = 1;
          break;
        }
      }
      if (!ok) io.println("[warn] orphan hole");
    }
  }
  return lands;
}

func triangulate_all(ps:list[list[vec[f32,2]]]):list[vec[f32,2]]{
  qs := unhole(ps);
  P := list[vec[f32,2]]{};
  for (i := 0; i < qs.length(); i++){
    tris := geom.triangulate(qs[i]);
    for (j := 0; j < tris.length(); j+=3){
      P.push(qs[i][tris[j]]);
      P.push(qs[i][tris[j+1]]);
      P.push(qs[i][tris[j+2]]);
    }
  }
  return P;
}

func extrude_glyph(mesh:rdr.Mesh,g:list[list[vec[f32,2]]],x0:f32,y0:f32,thick:f32){
  tris := triangulate_all(g);
  for (i := 0; i < tris.length(); i++){
    mesh.vertices.push({
      x0+tris[i].x, y0-tris[i].y, thick*0.5
    })
    mesh.normals.push({0.,0,1});
  }
  for (i := tris.length()-1; i >= 0; i--){
    mesh.vertices.push({
      x0+tris[i].x, y0-tris[i].y, -thick*0.5
    })
    mesh.normals.push({0.,0,-1});
  }
  for (i := 0; i < g.length(); i++){
    for (j := 0; j < g[i].length(); j++){
      p0 := g[i][j];
      p1 := g[i][(j+1)%g[i].length()];
      a := {x0+p0.x, y0-p0.y, thick*0.5}
      b := {x0+p1.x, y0-p1.y, thick*0.5}
      c := {x0+p0.x, y0-p0.y,-thick*0.5}
      d := {x0+p1.x, y0-p1.y,-thick*0.5}
      mesh.vertices.push(a);
      mesh.vertices.push(b);
      mesh.vertices.push(c); 
      mesh.vertices.push(b);
      mesh.vertices.push(d);
      mesh.vertices.push(c);
      nml := (b-a).cross(c-b).dir();
      for (k := 0; k < 6; k++){
        mesh.normals.push(nml);
      }
    }
  }
}


func make_mesh(text:str):rdr.Mesh{
  mesh := rdr.Mesh{};
  lines := text.split("\n");
  for (k := 0; k < lines.length(); k++){
    s := lines[k];
    offs := list[f32]{};
    ids := list[i32]{};
    for (i := 0; i < s.length()+1; i++){
      a := 0;
      if (i < s.length()){
        a = tf.lookup(s[i],font.FEAT_NONE);
        ids.push(a);
      }
      if (i){
        offs.push(offs[i-1]+tf.advance(ids[i-1],a,font.FEAT_KERN));
      }else{
        offs.push(0.0);
      }
    }
    for (i := 0; i < s.length(); i++){
      g := tf.glyph(ids[i],2);
      extrude_glyph(
        mesh,g,
        offs[i]-offs[offs.length()-1]*0.5,
        (lines.length()*0.5-k-1.0)*1.25,
        0.2
      );
    }
  }
  return mesh;
}


func make_wireframe(mesh:rdr.Mesh):rdr.Mesh{
  wire := rdr.Mesh{
    mode: rdr.MODE_LINE_LIST,
    vertices: mesh.vertices,
  };
  for (i := 0; i < mesh.vertices.length(); i+=3){
    wire.indices.push(i);
    wire.indices.push(i+1);
    wire.indices.push(i+1);
    wire.indices.push(i+2);
    wire.indices.push(i+2);
    wire.indices.push(i);
    wire.colors.push({0.,0,0,1})
    wire.colors.push({0.,0,0,1})
    wire.colors.push({0.,0,0,1})
  }
  return wire;
}



mesh := make_mesh("I stood tip-toe upon a little hill,
The air was cooling, and so very still,
That the sweet buds which with a modest pride
Pull droopingly, in slanting curve aside,
Their scantly leaved, and finely tapering stems,
Had not yet lost those starry diadems
Caught from the early sobbing of the morn.")
wire := make_wireframe(mesh);

W := 640
H := 480
context := win.init(W,H,win.CONTEXT_3D)
rdr.init(context);
frag.init(context);


normal_material := frag.program(embed (func(
  @varying normal:vec[f32,3],
  @varying uv:vec[f32,2],
):vec[f32,4]{
  c := normal*0.5+0.5;
  return {c.x,c.y,c.z,1.0};
}) as "fragment");

cam := rdr.Camera{};
cam.perspective(60,W/(H as f32),0.01,100.0);

hud := rdr.Camera{};
hud.ortho(0,W,H,0,-1,1);

yaw := math.PI/6;
pitch := math.PI/12;
zoom := 3.0;
drag := {0.,0.,0.};
targ := {0.,0.,0.};
keys_held := dict[i32,i32]{};

l_dir := {1.0,2.0,3.0}.dir();

while (1){
  framerate := time.fps(120);
  rdr.background(0.9);

  eye := {
    math.cos(pitch)*math.sin(yaw),
    math.sin(pitch),
    math.cos(pitch)*math.cos(yaw)
  }*zoom;
  horz := eye.cross({0,1.,0}).dir();
  vert := eye.cross(horz).dir();
  cam.look_at(eye+targ,targ,rdr.AXIS_Y);

  frag.begin(normal_material);
  cam.begin();
  mesh.draw(rdr.mat.id);
  cam.end();
  frag.end();

  cam.begin();
  wire.draw(rdr.mat.translate(...(eye.dir()*0.005)));
  cam.end();

  hud.begin();
  rdr.text(
    " [LMB-DRAG] ROTATE  [RMB-DRAG/SHIFT-DRAG] PAN  [WHEEL] ZOOM  #TRI:%{mesh.vertices.length()/3} FPS:%{framerate as i32}   ",
    rdr.mat.translate(0,H-16,0)
  );
  hud.end();


  e := win.poll();
  if (e.type == win.MOUSE_PRESSED){
    drag = {e.x,e.y,(e.key==win.MOUSE_RIGHT || keys_held[win.KEY_LSHIFT as i32])?-1.0:1.0};
  }else if (e.type == win.MOUSE_RELEASED){
    drag = {e.x,e.y,0.0};
  }else if (e.type == win.MOUSE_MOVED){
    if (drag.z){
      dx := drag.x - e.x;
      dy := drag.y - e.y;
      if (drag.z > 0){
        yaw -= dx*0.01;
        pitch -= dy*0.01;
        pitch = math.min(math.max(pitch,-math.PI/2+0.01),math.PI/2-0.01);
      }else{
        targ -= horz * dx*0.005*zoom - vert * dy*0.005*zoom;
      }
      drag = {e.x,e.y,drag.z};
    }
  }else if (e.type == win.WHEEL_SCROLLED){
    zoom += e.y*0.01;
    if (zoom < 0.1){
      zoom = 0.1;
    }else if (zoom > 100.0){
      zoom = 100.0;
    }
  }else if (e.type == win.KEY_PRESSED){
    keys_held[e.key] = 1;
  }else if (e.type == win.KEY_RELEASED){
    keys_held[e.key] = 0;
  }
}

