include "std/rand"
include "std/geom"
include "std/math"
include "std/list"
include "std/vec"
include "std/io"
include "std/drw"

W := 512
H := 512

func poisson_sample(weights:list[f32]):list[vec[f32,2]]{
  n := weights.length();
  ps := list[vec[f32,2]]{};
  for (i := 0; i < n; i++){
    dM := 0.0;
    pM := {0.0,0.0}
    for (j := 0; j < 10; j++){
      p := rand.random({0.0,0.0},{W,H});
      d := math.INF;
      for (k := 0; k < ps.length(); k++){
        d <?= (p - ps[k]).mag()/weights[k];
      }
      if (d > dM){
        dM = d;
        pM = p;
      }
    }
    ps.push(pM);
  }
  return ps;
}

weights := list[f32]{};
for (i := 0; i < 20; i++){
  weights.push(2.0);
}
for (i := 0; i < 180; i++){
  weights.push(1.0);
}

sites := poisson_sample(weights);
cells := geom.voronoi(sites);

celli := list[list[i32]]{};

corner_xs := list[vec[f32,2]]{};
corner_ns := list[list[i32]]{};
corner_ss := list[list[i32]]{};
corner_qs := list[list[i32]]{};


func is_oob(p:vec[f32,2]):i32{
  if (p.x < 0) return 1;
  if (p.x >= W) return 1;
  if (p.y < 0) return 1;
  if (p.y >= H) return 1;
  return 0;
}

func find_corner(v:vec[f32,2]):i32{
  if (is_oob(v)) return -1;
  for (i := 0; i < corner_xs.length(); i++){
    if ((corner_xs[i]-v).mag()<0.0001){
      return i;
    }
  }
  corner_xs.push(v);
  corner_ns.push(list[i32]{});
  corner_ss.push(list[i32]{});
  corner_qs.push(list[i32]{});
  return corner_xs.length()-1;
}

func add_edge(nbr:list[list[i32]],a:i32,b:i32){
  if (a < 0) return;
  if (b < 0) return;
  for (i := 0; i < nbr[a].length(); i++){
    if (nbr[a][i] == b){
      return;
    }
  }
  nbr[a].push(b);
}

for (i := 0; i < cells.length(); i++){
  celli.push(list[i32]{});
  
  if (!cells[i].length()) continue;
  idx0 := find_corner(cells[i][cells[i].length()-1]);
  for (j := 0; j < cells[i].length(); j++){
    idx1 := find_corner(cells[i][j]);
    celli[i].push(idx1);
    if (idx1 > 0) corner_ss[idx1].push(i);
    add_edge(corner_ns,idx0,idx1);
    add_edge(corner_ns,idx1,idx0);
    idx0 = idx1;
  }
}

func calc_turn(p0:vec[f32,2],p1:vec[f32,2],p2:vec[f32,2]):f32{
  a := p1 - p0;
  b := p2 - p1;
  cross := a.x*b.y - a.y*b.x
  dot   := a.x*b.x + a.y*b.y
  angle := math.atan2(cross, dot);
  return angle;
}

visited := list[i32]{};
for (i := 0; i < corner_xs.length(); i++) visited.push(0)

paths := list[list[i32]]{};

func walk(path:list[i32],cur:i32){
  if (visited[cur]){
    return;
  }
  path.push(cur);
  visited[cur] = 1;
  for (i := 0; i < corner_ns[cur].length(); i++){
    if (!visited[corner_ns[cur][i]]){
      if (path.length() > 1){
        q := path[path.length()-2];
        p0 := {0.0,0.0};
        if (q < -1){
          p0 = sites[-q-2];
        }else{
          p0 = corner_xs[q];
        }
        p1 := corner_xs[cur];
        p2 := corner_xs[corner_ns[cur][i]];
        angle := calc_turn(p0,p1,p2);
        bob := -1;
        for (k := 0; k < corner_ss[corner_ns[cur][i]].length(); k++){
          si := corner_ss[corner_ns[cur][i]][k];
          if (weights[si] > 1.0 && assign[si].length()==0){
            p3 := sites[si];
            angle2 := calc_turn(p1,p2,p3);
            if (math.abs(angle2) < math.PI/2.0){
              bob = si;
              break;
            }
          }
        }
        // if (math.abs(angle) < math.PI/2.0){
        if (-math.PI/4.0 < angle && angle < math.PI/2.0){
          if (bob == -1){
            walk(path,corner_ns[cur][i]);
          }else{
            assign[bob].push(corner_ns[cur][i]);
            visited[corner_ns[cur][i]] = 1;
            path.push(corner_ns[cur][i]);
            path.push(-2-bob);
          }
          return;
        }
      
      }else{
        walk(path,corner_ns[cur][i]);
        return;
      }
    }
  }
}
func walk_all(prv:i32,cur:i32){
  if (prv == -1 && cur == -1){
    for (i := 0; i < sites.length(); i++){
      if (weights[i] <= 1.0) continue;
      if (assign[i].length()) continue;
      for (j := 0; j < celli[i].length(); j++){
        if (celli[i][j] < 0) continue;
        if (visited[celli[i][j]]) continue;
        assign[i].push(celli[i][j]);
        walk_all(-2 - i, celli[i][j]);
        return;
      }
    }
    for (i := 0; i < visited.length(); i++){
      if (!visited[i]){
        walk_all(-1,i)
        return;
      }
    }
    return;
  }
  path := list[i32]{}
  if (prv != -1){
    path.push(prv);
  }
  walk(path,cur);
  if (path.length()>1){
    paths.push(path);
  }
  for (k := 0; k < paths.length(); k++){
    for (i := 1; i < paths[k].length()-1; i++){
      for (j := 0; j < corner_ns[paths[k][i]].length(); j++){
        if (!visited[corner_ns[paths[k][i]][j]]){
          visited[paths[k][i]] ++;
          walk_all(paths[k][i],corner_ns[paths[k][i]][j]);
          return;
        }
      }
    }
  }
  walk_all(-1,-1);
}


func poly_area(pts:list[vec[f32,2]]):f32{
  area := 0.0;
  n := pts.length();
  for (i := 0; i < n; i++) {
    ({x0, y0}) := pts[i];
    ({x1, y1}) := pts[(i + 1) % n];
    cross := x0 * y1 - x1 * y0;
    area += cross;
  }
  area *= 0.5;
  return area;
}

func centroid(pts:list[vec[f32,2]]):vec[f32,2]{
  area := 0.0;
  cx := 0.0;
  cy := 0.0;
  n := pts.length();
  for (i := 0; i < n; i++) {
    ({x0, y0}) := pts[i];
    ({x1, y1}) := pts[(i + 1) % n];
    cross := x0 * y1 - x1 * y0;
    area += cross;
    cx += (x0 + x1) * cross;
    cy += (y0 + y1) * cross;
  }
  area *= 0.5;
  f := 1.0 / (6.0 * area);
  return {cx * f, cy * f};
}


func relax(){
  cs := geom.voronoi(corner_xs);
  for (i := 0; i < cs.length(); i++){
    bad := 0;
    for (j := 0; j < cs[i].length(); j++){
      if (is_oob(cs[i][j])){
        bad = 1;
        break;
      }
    }
    if (bad) continue;
    c := centroid(cs[i]);

    f := (c - corner_xs[i])*0.5;
    for (j := 0; j < corner_ss[i].length(); j++){
      si := corner_ss[i][j];
      d := (corner_xs[i]-sites[si]) * (weights[si]-1.0) * 0.1;
      f += d;
    }
    corner_xs[i] += f;
  }
}


func checkclip(a:vec[f32,2],b:vec[f32,2]):vec[f32,2]{
  if (a.x < 0 && b.x >= 0){
    t := (0-a.x)/(b.x-a.x);
    return {0.0, a.y*(1-t)+b.y*t};
  }
  if (a.y < 0 && b.y >= 0){
    t := (0-a.y)/(b.y-a.y);
    return {a.x*(1-t)+b.x*t,0.0};
  }
  if (a.x >= W && b.x < W){
    t := (W-b.x)/(a.x-b.x);
    return {W-0.0001, b.y*(1-t)+a.y*t};
  }
  if (a.y >= H && b.y < H){
    t := (H-b.y)/(a.y-b.y);
    return {b.x*(1-t)+a.x*t,H-0.0001};
  }

  return a;
}
func ezclip(ps:list[vec[f32,2]]){
  off := 0;
  start := 0;
  mask := list[i32]{};
  for (i := 0; i < ps.length(); i++) mask.push(0);

  for (i := 0; i < ps.length(); i++){
    if (!is_oob(ps[i])){
      start = i;
      break;
    }
  }
  for (i := start; i < ps.length()+start; i++){
    ix := i % ps.length();
    i0 := (i-1+ps.length()) % ps.length();
    i1 := (i+1) % ps.length();
    if (off == 0){
      if (!is_oob(ps[i0]) && is_oob(ps[ix])){
        p := checkclip(ps[ix],ps[i0]);
        p = checkclip(p,ps[i0]);
        if (is_oob(ps[ix]) && !is_oob(ps[i1])){
          q := checkclip(ps[ix],ps[i1]);
          q = checkclip(q,ps[i1]);
          ps[ix] = (p+q)*0.5;
        }else{
          ps[ix] = p;
          off = 1;
          mask[ix] = -1;
        }
      }
    }else if (off > 0){
      if (is_oob(ps[ix]) && !is_oob(ps[i1])){
        ps[ix] = checkclip(ps[ix],ps[i1]);
        ps[ix] = checkclip(ps[ix],ps[i1]);
        off = 0;
        mask[ix] = -2;
      }else{
        mask[ix] = off;
        off++;        
      }
    }
  }
  for (i := 0; i < ps.length(); i++){
    if (mask[i] == -2){
      n := mask[(i-1+ps.length())%ps.length()];
      if (n < 0){
        return;
      }
      a := ps[(i-1-n+ps.length())%ps.length()];
      b := ps[i];
      d := b-a;
      e := {d.y, -d.x};
      for (j := 0; j < n; j++){
        t := (j+1.0) / (n + 1.0);
        ps[(i-1-j+ps.length())%ps.length()] = a*t + b*(1-t) + e*math.sin(t*math.PI)*0.1;
      }
    }
  }

}


relax();
relax();
relax();


for (i := 0; i < sites.length(); i++){
  bad := 0;
  for (j := 0; j < celli[i].length(); j++){
    idx := celli[i][j];
    if (idx >= 0){
      cells[i][j] = corner_xs[idx];
    }else{
      bad = 1;
    }
  }
  if (bad) ezclip(cells[i]);
}

for (i := 0; i < sites.length(); i++){
  sites[i] = centroid(cells[i]);
}

assign := list[list[i32]]{};
for (i := 0; i < sites.length(); i++){
  assign.push(list[i32]{});
}


walk_all(-1,-1);

for (i := 0; i < paths.length(); i++){
  for (j := 0; j < paths[i].length()-1; j++){

    add_edge(corner_qs, paths[i][j],paths[i][j+1]);
    add_edge(corner_qs, paths[i][j+1],paths[i][j]);
  }
}


func opt_bud(idx0:i32,idx1:i32):i32{
  if (idx1 < -1){
    return -1;
  }
  if (visited[idx1] > 1){
    return -1;
  }
  p0 := {0.0,0.0};
  if (idx0 < -1){
    p0 = sites[-idx0-2];
  }else{
    p0 = corner_xs[idx0];
  }
  p1 := corner_xs[idx1];
  ma := 0.0;
  mi := -1;
  for (j := 0; j < corner_ss[idx1].length(); j++){
    si := corner_ss[idx1][j];
    if (assign[si].length()) continue;
    p2 := sites[si];
    ang := math.abs(calc_turn(p0,p1,p2));
    area := math.abs(poly_area(cells[si]));
    // io.println(ang);
    if (area > ma && ang < math.PI/2.0){
      mi = si;
      ma = area;
    }
  }
  if (mi < 0) return mi;
  assign[mi].push(idx1);
  return mi;
}

func dist_pt_to_ln(x:f32,y:f32,x1:f32,y1:f32,x2:f32,y2:f32):f32{
  A := x - x1; 
  B := y - y1; 
  C := x2 - x1; 
  D := y2 - y1;
  dot := A*C+B*D;
  len_sq := C*C+D*D;
  param := 0.0;
  if (len_sq != 0) {
    param = dot / len_sq;
  }else{
    return 0.0;
  }
  xx := x1 + param*C;
  yy := y1 + param*D;
  dx := x - xx;
  dy := y - yy;
  return math.sqrt(dx*dx+dy*dy);
}

ends := list[i32]{}

for (i := 0; i < paths.length(); i++){
  e := paths[i][paths[i].length()-1];

  if (e >= 0){
    for (k := 0; k < corner_ss[e].length(); k++){
      si := corner_ss[e][k];
      if (weights[si] > 1.0 && assign[si].length()==0){
        paths[i].push(-2-si);
        assign[si].push(e);
        break;
      }
    }
  }
  ends.push(
    opt_bud(paths[i][paths[i].length()-2], paths[i][paths[i].length()-1])
  )
}

for (i := 0; i < celli.length(); i++){
  if (assign[i].length()) continue;
  md := 0.0;
  m0 := -1;
  m1 := -1;
  m2 := -1;
  for (j := 0; j < celli[i].length(); j++){
    a := celli[i][j];
    b := celli[i][(j+1)%celli[i].length()];
    if (a == -1 || b == -1) continue;
    ok := 0;
    for (k := 0; k < corner_qs[a].length(); k++){
      if (corner_qs[a][k] == b){
        ok = 1;
        break;
      }
    }
    if (!ok) continue;

    p0 := corner_xs[a];
    p1 := corner_xs[b];

    dd := 0.0;
    dk := -1;
    for (k := 0; k < cells[i].length(); k++){
      if (k == j) continue;
      if (k == (j+1)%cells[i].length()) continue;
      p2 := cells[i][k];
      d := dist_pt_to_ln(...p2, ...p0,...p1);
      if (d > dd){
        dd = d;
        dk = k;
      }
    }
    if (dk >= 0 && dd > md){
      md = dd;
      m0 = a;
      m1 = b;
      m2 = dk;
    }
  }
  if (m0 >= 0){
    assign[i].push(m0);
    assign[i].push(m1);
    assign[i].push(m2);
  }
}


func natural_cubic_bezier(points:list[vec[f32,2]]):list[list[vec[f32,2]]]{
  n := points.length() - 1;
  if (n < 1) return list[list[vec[f32,2]]]{};
  if (n == 1) {
    p0 := points[0];
    p3 := points[1];
    c1 := p0 + (p3-p0)*(1.0/3.0);
    c2 := p0 + (p3-p0)*(2.0/3.0);
    return list[list[vec[f32,2]]]{list[vec[f32,2]]{p0, c1, c2, p3}};
  }
  func solve(rhs:list[f32]):list[f32]{
    m := rhs.length();
    x   := rhs.map(func(v:f32):f32{return 0.0});
    tmp := rhs.map(func(v:f32):f32{return 0.0});
    b := 2.0;
    x[0] = rhs[0] / b;
    for (i := 1; i < m; i++) {
      tmp[i] = 1.0 / b;
      b = ((i < m - 1) ? 4.0 : 3.5) - tmp[i];
      x[i] = (rhs[i] - x[i-1]) / b;
    }
    for (i := 1; i < m; i++) {
      x[m-1-i] -= tmp[m-i] * x[m-i];
    }
    return x;
  }
  func control_points_1d(K:list[f32]):list[f32]{
    m := K.length() - 1;
    rhs := list[f32]{};
    rhs.push(K[0] + 2*K[1]);
    for (i := 1; i < m - 1; i++) rhs.push(4.0*K[i] + 2.0*K[i+1]);
    rhs.push((8.0*K[m-1] + K[m]) / 2.0);
    return solve(rhs);
  }
  X := points.map(func(p:vec[f32,2]):f32{return p.x});
  Y := points.map(func(p:vec[f32,2]):f32{return p.y});

  p1x := control_points_1d(X);
  p1y := control_points_1d(Y);

  segments := list[list[vec[f32,2]]]{};
  for (i := 0; i < n; i++) {
    p0 := points[i];
    p3 := points[i+1];
    c1 := {p1x[i], p1y[i]};
    c2 := {0.0,0.0};
    if (i < n - 1) {
      c2 = {2*X[i+1] - p1x[i+1], 2*Y[i+1] - p1y[i+1]};
    } else {
      c2 = {(X[n] + p1x[n-1]) / 2, (Y[n] + p1y[n-1]) / 2};
    }
    segments.push(list[vec[f32,2]]{p0, c1, c2, p3});
  }
  return segments;
}


func smoothen(pts:list[vec[f32,2]]):list[vec[f32,2]]{
  out := list[vec[f32,2]]{};
  pms := list[f32]{};
  nats := natural_cubic_bezier(pts);
  for (i := 0; i < nats.length(); i++){
    for (t:=0.0; t<1.0; t+=0.05){
      v := geom.curve[2](nats[i], pms, t, geom.TYPE_BEZIER | geom.ORD_CUBIC);
      out.push(v);
    }
  }
  return out;
}

vines := list[list[vec[f32,2]]]{};
for (i := 0; i < paths.length(); i++){
  pts := list[vec[f32,2]]{}
  for (j := 0; j < paths[i].length(); j++){
    q := paths[i][j];
    if (q < -1){
      pts.push(sites[-q-2])
    }else{
      pts.push(corner_xs[q])
    }
  }
  if (ends[i] >= 0){
    pts.push(sites[ends[i]]);
  }
  vines.push(smoothen(pts));
}

leaves := list[list[vec[f32,2]]]{};
veins := list[list[vec[f32,2]]]{};

for (i := 0; i < assign.length(); i++){
  if (assign[i].length() != 3) continue;
  p0 := corner_xs[assign[i][0]];
  p1 := corner_xs[assign[i][1]];
  p2 := sites[i];
  p3 := cells[i][assign[i][2]];
  

  d := (p1-p0)*0.5;
  q0 := (p0+p1)*0.5;
  q1 := (q0 + p2)*0.5;
  q2 := p2;
  q3 := (p2 + p3)*0.5;

  l := (p3-q0).mag();
  if (d.mag() <  l*0.15){
    d = d.dir()*l*0.15;
  }
  d *= 1.3;

  pts0 := list[vec[f32,2]]{};
  pts1 := list[vec[f32,2]]{};

  pms := list[f32]{};
  cl := list[vec[f32,2]]{
    q0, q1-d, q2-d*0.65, q3
  }
  cr := list[vec[f32,2]]{
    q3, q2+d*0.65, q1+d, q0
  }
  for (t := 0.0; t <= 1.0; t += 0.05){
    v := geom.curve[2](cl, pms, t, geom.TYPE_BEZIER | geom.ORD_CUBIC);
    pts0.push(v);
  }
  for (t := 0.0; t <= 1.0; t += 0.05){
    v := geom.curve[2](cr, pms, t, geom.TYPE_BEZIER | geom.ORD_CUBIC);
    pts0.push(v);
  }
  for (i := 0; i < pts0.length()*0.42; i++){
    v0 := pts0[i];
    v1 := pts0[pts0.length()-1-i];
    pts1.push(v0*0.6+v1*0.4);
  }
  for (i := 3; i < pts1.length()-3; i+=3){
    t := (i as f32) / pts1.length();
    t = t*0.7 + 0.3;
    j : i32 = pts0.length()*0.5 * t;
    pts2 := list[vec[f32,2]]{};
    
    pts2.push(pts1[i]);
    if (((i-3)/3) & 1){
      pts2.push(pts0[j]*0.7 + pts1[i]*0.3);
    }else{
      pts2.push(pts0[pts0.length()-1-j]*0.7 + pts1[i]*0.3);
    }
    // veins.push(pts2);
  }
  veins.push(pts1);
  leaves.push(pts0);
}

flowers := list[list[vec[f32,2]]]{};

func ray_polygon(q0:vec[f32,2],q1:vec[f32,2],poly:list[vec[f32,2]]):vec[f32,2]{
  for (i := 0; i < poly.length(); i++){
    p0 := poly[i];
    p1 := poly[(i+1)%poly.length()];
    [b,v] := geom.line_intersect(q0,q1,p0,p1,geom.LHS_RAY|geom.RHS_SEGMENT|geom.RET_POINTS);
    if (b){
      return v;
    }
  }
  return q1;
}

func shuffle[T](a:list[T]) {
  for (i := a.length() - 1; i > 0; i--) {
    j := rand.random(0.0,i+1.0) as i32;
    ;([a[i], a[j]]) = [a[j], a[i]];
  }
}

func opt_flower(ci:i32,si:i32){
  p0 := corner_xs[ci];
  p1 := sites[si];
  dp := p1 - p0;
  ep := {-dp.y,dp.x};
  q0 := p0*0.7+p1*0.3;

  n := 16;
  vs := list[vec[f32,2]]{}

  sz := dp.mag();

  ang0 := math.atan2(dp.y,dp.x);

  for (i := 0; i < n; i++){
    ang := ((i / ((n-1) as f32))-0.5) * (math.PI) + ang0;
    q1 := q0 + {
      math.cos(ang),
      math.sin(ang)
    }
    q2 := ray_polygon(q0,q1,cells[si]);
    l := (q2-q0).mag();
    if (l > sz){
      vs.push(q2);
    }
  }
  vs = vs.slice(1,vs.length()-1);

  idcs := list[i32]{};
  for (i := 0; i < vs.length(); i++) idcs.push(i);
  shuffle(idcs);
  
  pms := list[f32]{};
  nn := vs.length();
  if (nn > 8) nn = 8;
  for (i := 0; i < nn; i++){
    idx := idcs[i];
    t := (idx as f32) / (vs.length()-1);
    ti := (i as f32) / nn;

    sh := 0.1;
    if (i > nn/2){
      sh = 0.3
    }
    q1 := (vs[idx]-q0)*(1.0-sh-ti*0.1)+q0;
    d := q1-q0;
    e := {-d.y,d.x};
    
    if (i == nn/2){
      
      for (j := 0; j < 8; j++){
        a1 := rand.random(0.0,math.PI*2);
        r1 := rand.random(0.0,sz*0.4);
        og := p1 + {
          math.cos(a1)*r1,
          math.sin(a1)*r1
        }
        a2 := math.atan2(...(og.yx-q0.yx))
        pts := list[vec[f32,2]]{
          q0
        };
        for (k := 0; k < 10; k++){
          a := (k/9.0-0.5) * math.PI*1.6 + a2
          pts.push({
            math.cos(a)*3
            math.sin(a)*3
          }+og)
        }
        pts.push(q0);
        flowers.push(pts);
      }
      
    }

    w := math.sin(t*math.PI);
    e = e.dir() * sz * (w * 0.1 + 0.2);

    cl := list[vec[f32,2]]{
      q0,
      q0*0.7 + q1*0.3 + e*1.2,
      q1 + e,
      q0*0.1 + q1*0.9 + e*0.3
    }
    cm := list[vec[f32,2]]{
      q0*0.1 + q1*0.9 + e*0.3,
      q1 + e*0.1,
      q1 - e*0.1,
      q0*0.1 + q1*0.9 - e*0.3,
    }
    cr := list[vec[f32,2]]{
      q0*0.1 + q1*0.9 - e*0.3,
      q1 - e,
      q0*0.7 + q1*0.3 - e*1.2,
      q0,
    }
    pts := list[vec[f32,2]]{};
    
    for (t := 0.0; t < 1.0; t += 0.05){
      v := geom.curve[2](cl, pms, t, geom.TYPE_BEZIER | geom.ORD_CUBIC);
      pts.push(v);
    }
    for (t := 0.0; t < 1.0; t += 0.05){
      v := geom.curve[2](cm, pms, t, geom.TYPE_BEZIER | geom.ORD_CUBIC);
      pts.push(v);
    }
    for (t := 0.0; t < 1.0; t += 0.05){
      v := geom.curve[2](cr, pms, t, geom.TYPE_BEZIER | geom.ORD_CUBIC);
      pts.push(v);
    }
    flowers.push(pts);
  }
}


for (i := 0; i < paths.length(); i++){
  for (j := 0; j < paths[i].length(); j++){
    if (paths[i][j] < -1){
      if (j){
        opt_flower(paths[i][j-1],-paths[i][j]-2);
      }else{
        opt_flower(paths[i][j+1],-paths[i][j]-2);
      }
    }
  }
}


drw.size(768,768)

while (1){
  drw.background(0.0);
  drw.push_matrix();
  drw.translate(128,128);

  drw.fill(1);
  drw.stroke(0);
  drw.stroke_weight(1.5);
  for (i := 0; i < ends.length(); i++){
    if (ends[i]<0) continue;
    drw.push_matrix();
    p0 := corner_xs[paths[i][paths[i].length()-1]];
    p1 := sites[ends[i]];
    drw.translate(...sites[ends[i]])
    drw.rotate_deg(math.atan2(...((p1-p0).yx))*180.0/math.PI);
    drw.ellipse( 2,1, 16,14 );
    drw.ellipse( 4,-2, 20,14 );
    
    drw.pop_matrix();
  } 

  for (i := 0; i < leaves.length(); i++){
    drw.begin_shape();
    for (j := 0; j < leaves[i].length(); j++){
      drw.vertex(...leaves[i][j]);
    }
    drw.end_shape(1);
  }
  drw.stroke(0);
  drw.stroke_weight(1.5);
  drw.no_fill();
  for (i := 0; i < veins.length(); i++){
    drw.begin_shape();
    for (j := 0; j < veins[i].length(); j++){
      drw.vertex(...veins[i][j])
    }
    drw.end_shape();
  }

  drw.no_fill();
  drw.stroke(0)
  drw.stroke_weight(6);
  for (k := 0; k < vines.length(); k++){
    drw.begin_shape();
    for (i := 0; i < vines[k].length(); i++){
      drw.vertex(...vines[k][i])
    }
    drw.end_shape();
  } 
  drw.stroke(1)
  drw.stroke_weight(3);
  for (k := 0; k < vines.length(); k++){
    drw.begin_shape();
    for (i := 0; i < vines[k].length(); i++){
      drw.vertex(...vines[k][i])
    }
    drw.end_shape();
  }

  drw.stroke(0);
  drw.stroke_weight(1.5);
  drw.fill(1);
  for (i := 0; i < flowers.length(); i++){
    drw.begin_shape();
    for (j := 0; j < flowers[i].length(); j++){
      drw.vertex(...flowers[i][j])
    }
    drw.end_shape();
  }


  drw.pop_matrix();
  drw.poll();

}

