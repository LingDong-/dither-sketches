sidx := 0;

while (1){
  framerate := time.fps(120);
  rdr.background(0.2);

  if (frame % 60 == 0 && sidx < strings.length()){
    drop_box(strings[sidx], rand.random({-2.,-2.,2.5},{2.,2.,3.})+{0.,0.,objs.length()*0.05});
    sidx ++;
    // sidx %= strings.length();
  }

  eye := {
    math.cos(pitch)*math.sin(yaw),
    math.sin(pitch),
    math.cos(pitch)*math.cos(yaw)
  }*zoom;
  horz := eye.cross({0,1.,0}).dir();
  vert := eye.cross(horz).dir();
  cam.look_at(eye+targ,targ,rdr.AXIS_Y);

  ode.SpaceCollide(space, 0, near_callback);
  ode.WorldQuickStep(world, dt);
  ode.JointGroupEmpty(contactgroup);

  for (i := 0; i < objs.length(); i++){
    nbd := objs[i].bodies.length();
    curv := list[vec[f32,2]]{};
    imid : i32 = nbd/2;
    pmid := ode.BodyGetPosition(objs[i].bodies[imid]);
    rmid := ode.BodyGetRotation(objs[i].bodies[imid]);
    tinv := {
      rmid[0],rmid[4],rmid[8],0;
      rmid[1],rmid[5],rmid[9],0;
      rmid[2],rmid[6],rmid[10],0;
      0,0,0,1;
    } @* rdr.mat.translate(-pmid[0],-pmid[1],-pmid[2]);

    mtrf := yzup @* {
      rmid[0],rmid[1],rmid[2],pmid[0];
      rmid[4],rmid[5],rmid[6],pmid[1];
      rmid[8],rmid[9],rmid[10],pmid[2];
      0.,0.,0.,1.;
    } @* rdr.mat.scale(1.0)

    if (i >= transforms.length()){
      transforms.push(mtrf);
    }else{
      transforms[i] = mtrf;
    }
    
    for (j := 0; j < nbd; j++){
      pos := ode.BodyGetPosition(objs[i].bodies[j]);
      rot := ode.BodyGetRotation(objs[i].bodies[j]);
      trf := {
        rot[0],rot[1],rot[2],pos[0];
        rot[4],rot[5],rot[6],pos[1];
        rot[8],rot[9],rot[10],pos[2];
        0.,0.,0.,1.;
      };

      if (j == 0){
        curv.push((tinv @* trf @* {-objs[i].dims.x*0.5/nbd;0.0;0.0;1.0}).xz);
      }
      curv.push((tinv @* trf @* {objs[i].dims.x*0.5/nbd;0.0;0.0;1.0}).xz);

      wmat := yzup @* trf @* rdr.mat.scale(objs[i].dims.x*0.5/nbd, objs[i].dims.y*0.5, objs[i].dims.z*0.5);

      if (DBG&1){
        cam.begin();
        wbox.draw(wmat);
        cam.end();
      }
    }
    N := 500;
    pms := list[f32]{0.75};
    res := list[vec[f32,2]]{};
    for (i:=0;i<curv.length()-1;i++){
      i0 := i-1;
      if (i0 < 0) i0 = 0;
      i1 := i+2;
      if (i1 > curv.length()-1) i1--;
      pts := list[vec[f32,2]]{
        curv[i0], 
        curv[i], 
        curv[i+1], 
        curv[i1]
      };
      for (t:=0.0; t<1.0; t+=0.05){
        v := geom.curve(pts, pms, t, geom.TYPE_CATROM);
        res.push(v);
      }
    }
    res = geom.poly_resample(res, N, geom.MODE_POLYLINE|geom.BY_COUNT);
    xycs := list[vec[f32,4]]{};
    for (j := 0; j < res.length(); j++){
      p0 := j?(res[j-1]):(res[j]*2-res[j+1]);
      p1 := res[j];
      d := (p1 - p0).dir();
      xycs.push({res[j].x,res[j].y,d.x,d.y});
    }

    update_mesh(objs[i].mesh, objs[i].t_verts, objs[i].t_norms, objs[i].dims.x, xycs);
  }

  for (i := 0; i < objs.length(); i++){
    objs[i].mesh.update(rdr.DIRTY_VERTICES|rdr.DIRTY_NORMALS);
    objs[i].wire.update(rdr.DIRTY_VERTICES|rdr.DIRTY_NORMALS);
  }


  frag.begin(shadow_material,shadow);
  rdr.background(0.0);
  light.begin();
  for (i := 0; i < objs.length(); i++){
    objs[i].mesh.draw(transforms[i]);
  }
  plane.draw(rdr.mat.scale(2.0));
  light.end();
  frag.end();

  shadow_matrix := light.proj@*light.view;

  // frag.begin(normal_material);
  // cam.begin();
  // for (i := 0; i < objs.length(); i++){
  //   objs[i].mesh.draw(transforms[i]);
  // }
  // cam.end();
  // frag.end();

  if (DBG&2){
    cam.begin();
    for (i := 0; i < objs.length(); i++){
      objs[i].wire.draw(rdr.mat.translate(...(eye.dir()*0.01))@*transforms[i]);
    }
    cam.end();
  }

  frag.begin(phong_material);
  frag.uniform("l_dir",l_dir);
  frag.uniform("eye",eye+targ);
  frag.uniform("shininess",32.0);
  frag.uniform("col_ambi",{0.1,0.2,0.3});
  frag.uniform("col_spec",{0.6,0.4,0.3});
  frag.uniform("shadow_map",shadow);
  frag.uniform("shadow_matrix",shadow_matrix);
  cam.begin();
  for (i := 0; i < objs.length(); i++){
    t := (i%4)*0.3333;
    // frag.uniform("col_diff",{0.5,0.5,1.0}*(1-t)+{0.5,1.0,0.5}*t);
    color := {1.0,0.9,0.9};
    if (i % 3 == 1 && objs[i].dims.x > 2.0){
      color = {1.0,0.1,0.0};
    }
    frag.uniform("col_diff",color);
    objs[i].mesh.draw(transforms[i]);
  }
  cam.end();
  frag.end();

  frag.begin(floor_material);
  cam.begin();
  frag.uniform("shadow_map",shadow);
  frag.uniform("shadow_matrix",shadow_matrix);
  plane.draw(rdr.mat.id);
  cam.end();
  frag.end();


  hud.begin();
  rdr.text(
    " [LMB-DRAG] ROTATE  [RMB-DRAG/SHIFT-DRAG] PAN  [WHEEL] ZOOM  #FLOP:%{objs.length()} FPS:%{framerate as i32}     ",
    rdr.mat.translate(0,H-16,0)
  );
  hud.end();


  e := win.poll();
  if (e.type == win.MOUSE_PRESSED){
    drag = {e.x,e.y,(e.key==win.MOUSE_RIGHT || keys_held[win.KEY_LSHIFT as i32])?-1.0:1.0};
  }else if (e.type == win.MOUSE_RELEASED){
    drag = {e.x,e.y,0.0};
  }else if (e.type == win.MOUSE_MOVED){
    if (drag.z){
      dx := drag.x - e.x;
      dy := drag.y - e.y;
      if (drag.z > 0){
        yaw -= dx*0.01;
        pitch -= dy*0.01;
        pitch = math.min(math.max(pitch,-math.PI/2+0.01),math.PI/2-0.01);
      }else{
        targ -= horz * dx*0.005*zoom - vert * dy*0.005*zoom;
      }
      drag = {e.x,e.y,drag.z};
    }
  }else if (e.type == win.WHEEL_SCROLLED){
    zoom += e.y*0.01;
    if (zoom < 0.1){
      zoom = 0.1;
    }else if (zoom > 100.0){
      zoom = 100.0;
    }
  }else if (e.type == win.KEY_PRESSED){
    keys_held[e.key] = 1;
    if (e.key == 'd'){
      DBG = (DBG+1)%4;
    }
  }else if (e.type == win.KEY_RELEASED){
    keys_held[e.key] = 0;
  }
  frame++;
}

