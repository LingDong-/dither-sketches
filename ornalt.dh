W := 512
H := 512
preset := 1;

func pt_in_clipshape(v:vec[f32,2],polys:list[list[vec[f32,2]]]):i32{
  cnt := 0;
  for (i := 0; i < polys.length(); i++){
    if (geom.pt_in_poly(v,polys[i])){
      cnt++;
    }
  }
  return cnt&1;
}

func poly_area(pts:list[vec[f32,2]]):f32{
  area := 0.0;
  n := pts.length();
  for (i := 0; i < n; i++) {
    ({x0, y0}) := pts[i];
    ({x1, y1}) := pts[(i + 1) % n];
    cross := x0 * y1 - x1 * y0;
    area += cross;
  }
  area *= 0.5;
  return area;
}

func poisson_sample(weights:list[f32]):list[vec[f32,2]]{
  n := weights.length();
  ps := list[vec[f32,2]]{};
  for (i := 0; i < n; i++){
    dM := 0.0;
    pM := {0.0,0.0}
    for (j := 0; j < 16; j++){
      p := rand.random({0.0,0.0},{W,H});
      d := math.INF;
      for (k := 0; k < ps.length(); k++){
        d <?= (p - ps[k]).mag()/weights[k];
      }
      if (d > dM){
        dM = d;
        pM = p;
      }
    }
    ps.push(pM);
  }
  return ps;
}



func convexclip(poly:list[vec[f32,2]],clipshape:list[list[vec[f32,2]]]):tup[list[vec[f32,2]],list[i32]]{
  keep := list[vec[f32,2]]{};
  isects := list[vec[f32,2]]{};
  mask := list[i32]{};
  for (i := 0; i < poly.length(); i++){
    if (pt_in_clipshape(poly[i],clipshape)){
      keep.push(poly[i]);
    }
    p0 := poly[i];
    p1 := poly[(i+1)%poly.length()];
    for (j := 0; j < clipshape.length(); j++){
      for (k := 0; k < clipshape[j].length(); k++){
        if (geom.pt_in_poly(clipshape[j][k],poly)){
          keep.push(clipshape[j][k]);
          isects.push(clipshape[j][k]);
        }
        [b,v] := geom.line_intersect(
          p0,p1,clipshape[j][k],clipshape[j][(k+1)%clipshape[j].length()],
          geom.LHS_SEGMENT|geom.RHS_SEGMENT|geom.RET_POINTS
        );
        if (b){
          keep.push(v);
          isects.push(v);
        }
      }
    }
  }
  hull := geom.convex_hull(keep);
  for (i := 0; i < hull.length(); i++){
    mask.push(0);
    for (j := 0; j < isects.length(); j++){
      if ((isects[j]-hull[i]).mag()<0.0001){
        mask[i] = -1;
        break;
      }
    }
  }
  return [hull, mask];
}

func add_edge(nbr:list[list[i32]],a:i32,b:i32){
  if (a < 0) return;
  if (b < 0) return;
  for (i := 0; i < nbr[a].length(); i++){
    if (nbr[a][i] == b){
      return;
    }
  }
  nbr[a].push(b);
}

func calc_turn(p0:vec[f32,2],p1:vec[f32,2],p2:vec[f32,2]):f32{
  a := p1 - p0;
  b := p2 - p1;
  cross := a.x*b.y - a.y*b.x
  dot   := a.x*b.x + a.y*b.y
  angle := math.atan2(cross, dot);
  return angle;
}

func centroid(pts:list[vec[f32,2]]):vec[f32,2]{
  area := 0.0;
  cx := 0.0;
  cy := 0.0;
  n := pts.length();
  for (i := 0; i < n; i++) {
    ({x0, y0}) := pts[i];
    ({x1, y1}) := pts[(i + 1) % n];
    cross := x0 * y1 - x1 * y0;
    area += cross;
    cx += (x0 + x1) * cross;
    cy += (y0 + y1) * cross;
  }
  area *= 0.5;
  f := 1.0 / (6.0 * area);
  return {cx * f, cy * f};
}


func dist_pt_to_ln(x:f32,y:f32,x1:f32,y1:f32,x2:f32,y2:f32):f32{
  A := x - x1; 
  B := y - y1; 
  C := x2 - x1; 
  D := y2 - y1;
  dot := A*C+B*D;
  len_sq := C*C+D*D;
  param := 0.0;
  if (len_sq != 0) {
    param = dot / len_sq;
  }else{
    return 0.0;
  }
  xx := x1 + param*C;
  yy := y1 + param*D;
  dx := x - xx;
  dy := y - yy;
  return math.sqrt(dx*dx+dy*dy);
}



func natural_cubic_bezier(points:list[vec[f32,2]]):list[list[vec[f32,2]]]{
  n := points.length() - 1;
  if (n < 1) return list[list[vec[f32,2]]]{};
  if (n == 1) {
    p0 := points[0];
    p3 := points[1];
    c1 := p0 + (p3-p0)*(1.0/3.0);
    c2 := p0 + (p3-p0)*(2.0/3.0);
    return list[list[vec[f32,2]]]{list[vec[f32,2]]{p0, c1, c2, p3}};
  }
  func solve(rhs:list[f32]):list[f32]{
    m := rhs.length();
    x   := rhs.map(func(v:f32):f32{return 0.0});
    tmp := rhs.map(func(v:f32):f32{return 0.0});
    b := 2.0;
    x[0] = rhs[0] / b;
    for (i := 1; i < m; i++) {
      tmp[i] = 1.0 / b;
      b = ((i < m - 1) ? 4.0 : 3.5) - tmp[i];
      x[i] = (rhs[i] - x[i-1]) / b;
    }
    for (i := 1; i < m; i++) {
      x[m-1-i] -= tmp[m-i] * x[m-i];
    }
    return x;
  }
  func control_points_1d(K:list[f32]):list[f32]{
    m := K.length() - 1;
    rhs := list[f32]{};
    rhs.push(K[0] + 2*K[1]);
    for (i := 1; i < m - 1; i++) rhs.push(4.0*K[i] + 2.0*K[i+1]);
    rhs.push((8.0*K[m-1] + K[m]) / 2.0);
    return solve(rhs);
  }
  X := points.map(func(p:vec[f32,2]):f32{return p.x});
  Y := points.map(func(p:vec[f32,2]):f32{return p.y});

  p1x := control_points_1d(X);
  p1y := control_points_1d(Y);

  segments := list[list[vec[f32,2]]]{};
  for (i := 0; i < n; i++) {
    p0 := points[i];
    p3 := points[i+1];
    c1 := {p1x[i], p1y[i]};
    c2 := {0.0,0.0};
    if (i < n - 1) {
      c2 = {2*X[i+1] - p1x[i+1], 2*Y[i+1] - p1y[i+1]};
    } else {
      c2 = {(X[n] + p1x[n-1]) / 2, (Y[n] + p1y[n-1]) / 2};
    }
    segments.push(list[vec[f32,2]]{p0, c1, c2, p3});
  }
  return segments;
}


func hobby(points:list[vec[f32,2]], omega:f32) : list[list[vec[f32,2]]]{

  func thomas(A:list[f32],B:list[f32],C:list[f32],D:list[f32]):list[f32]{
    n := B.length() - 1;
    Cp := list[f32]{C[0]/B[0]};
    Dp := list[f32]{D[0]/B[0]};
    for (i := 1; i <= n; i++){
      denom := B[i] - Cp[i-1] * A[i];
      Cp.push(C[i] / denom);
      Dp.push((D[i] - Dp[i-1]*A[i]) / denom);
    }
    X := list[f32]{Dp[n]};
    for (i:=n-1; i>=0; i--){
      X.insert(0, Dp[i]-Cp[i]*X[0]);
    }
    return X;
  }
  func v_angle_between(v:vec[f32,2],w:vec[f32,2]):f32{
    return math.atan2(w.y * v.x - w.x * v.y, v.x * w.x + v.y * w.y);
  }
  func v_rot(v:vec[f32,2],angle:f32):vec[f32,2]{
    ca := math.cos(angle);
    sa := math.sin(angle);
    return {v.x * ca - v.y * sa, v.x * sa + v.y * ca}
  }
  func rho(alpha:f32, beta:f32):f32{
    c := 2./3.;
    return 2. / (1 + c * math.cos(beta) + (1 - c) * math.cos(alpha));
  }

  n := points.length()-1;

  if (n < 1) return list[list[vec[f32,2]]]{};
  if (n == 1) {
    p0 := points[0];
    p3 := points[1];
    c1 := p0 + (p3-p0)*(1.0/3.0);
    c2 := p0 + (p3-p0)*(2.0/3.0);
    return list[list[vec[f32,2]]]{list[vec[f32,2]]{p0, c1, c2, p3}};
  }

  chords := list[vec[f32,2]]{};
  d := list[f32]{};
  for (i := 0; i < n; i++){
    chords.push(points[i+1]-points[i]);
    d.push(chords[i].mag());
  }
  gamma := list[f32]{0};
  for (i := 1; i < n; i++){
    gamma.push(v_angle_between(chords[i-1], chords[i]));
  }
  gamma.push(0);

  A := list[f32]{0};
  B := list[f32]{2+omega};
  C := list[f32]{2*omega+1};
  D := list[f32]{-1*C[0]*gamma[1]};

  for (i := 1; i < n; i++){
    A.push(1./d[i-1]);
    B.push((2.*d[i-1]+2.*d[i])/(d[i-1]*d[i]));
    C.push(1./d[i]);
    D.push((-1.*(2.*gamma[i]*d[i]+gamma[i+1]*d[i-1]))/(d[i-1]*d[i]));
  }

  A.push(2*omega+1);
  B.push(2+omega);
  C.push(0);
  D.push(0);

  alpha := thomas(A,B,C,D);
  beta := list[f32]{};

  for (i := 0; i < n - 1; i ++){
    beta.push(-1 * gamma[i+1] - alpha[i+1]);
  }
  beta.push(-1*alpha[n]);

  c0 := list[vec[f32,2]]{};
  c1 := list[vec[f32,2]]{};

  for (i := 0; i < n; i++){
    a := rho(alpha[i],beta[i])*d[i] / 3.;
    b := rho(beta[i],alpha[i])*d[i] / 3.;
    c0.push( points[i]   + v_rot(chords[i],alpha[i]).dir() * a);
    c1.push( points[i+1] - v_rot(chords[i],-beta[i]).dir() * b);
  }

  res := list[list[vec[f32,2]]]{};
  for (i := 0; i < n; i++){
    res.push(list[vec[f32,2]]{
      points[i], c0[i], c1[i], points[i+1]
    })
  }
  return res;
}


func smoothen(pts:list[vec[f32,2]]):list[vec[f32,2]]{
  out := list[vec[f32,2]]{};
  pms := list[f32]{};
  // nats := natural_cubic_bezier(pts);
  nats := hobby(pts,1.0);
  for (i := 0; i < nats.length(); i++){
    for (t:=0.0; t<1.0; t+=0.05){
      v := geom.curve[2](nats[i], pms, t, geom.TYPE_BEZIER | geom.ORD_CUBIC);
      out.push(v);
    }
  }
  return out;
}

func ray_polygon(q0:vec[f32,2],q1:vec[f32,2],poly:list[vec[f32,2]]):vec[f32,2]{
  for (i := 0; i < poly.length(); i++){
    p0 := poly[i];
    p1 := poly[(i+1)%poly.length()];
    [b,v] := geom.line_intersect(q0,q1,p0,p1,geom.LHS_RAY|geom.RHS_SEGMENT|geom.RET_POINTS);
    if (b){
      return v;
    }
  }
  return q1;
}

func shuffle[T](a:list[T]) {
  for (i := a.length() - 1; i > 0; i--) {
    j := rand.random(0.0,i+1.0) as i32;
    ;([a[i], a[j]]) = [a[j], a[i]];
  }
}


weights := list[f32]{};
sites := list[vec[f32,2]]{};
cells := list[list[vec[f32,2]]]{};
celli := list[list[i32]]{};
corner_xs := list[vec[f32,2]]{};
corner_ns := list[list[i32]]{};
corner_ss := list[list[i32]]{};
corner_qs := list[list[i32]]{};
visited := list[i32]{};
paths := list[list[i32]]{};
color0 := {0.0,0.0,0.0};
color1 := {0.7,0.9,0.8};
color2 := {0.9,0.8,0.6};
color3 := {1.0,0.5,0.4};

func find_corner(i:i32,j:i32):i32{
  v := cells[i][j];
  if (celli[i][j]<0){
    return -1;
  }
  for (i := 0; i < corner_xs.length(); i++){
    if ((corner_xs[i]-v).mag()<0.0001){
      return i;
    }
  }
  corner_xs.push(v);
  corner_ns.push(list[i32]{});
  corner_ss.push(list[i32]{});
  corner_qs.push(list[i32]{});
  return corner_xs.length()-1;
}


func walk(path:list[i32],cur:i32){
  if (visited[cur]){
    return;
  }
  path.push(cur);
  visited[cur] = 1;
  for (i := 0; i < corner_ns[cur].length(); i++){
    if (!visited[corner_ns[cur][i]]){
      if (path.length() > 1){
        q := path[path.length()-2];
        p0 := {0.0,0.0};
        if (q < -1){
          p0 = sites[-q-2];
        }else{
          p0 = corner_xs[q];
        }
        p1 := corner_xs[cur];
        p2 := corner_xs[corner_ns[cur][i]];
        angle := calc_turn(p0,p1,p2);
        bob := -1;
        for (k := 0; k < corner_ss[corner_ns[cur][i]].length(); k++){
          si := corner_ss[corner_ns[cur][i]][k];
          if (weights[si] > 1.0 && assign[si].length()==0){
            p3 := sites[si];
            angle2 := calc_turn(p1,p2,p3);
            if (math.abs(angle2) < math.PI/2.0){
              bob = si;
              break;
            }
          }
        }
        if (-math.PI/4.0 < angle && angle < math.PI/2.0){
          if (bob == -1){
            walk(path,corner_ns[cur][i]);
          }else{
            assign[bob].push(corner_ns[cur][i]);
            visited[corner_ns[cur][i]] = 1;
            path.push(corner_ns[cur][i]);
            path.push(-2-bob);
          }
          return;
        }
      
      }else{
        walk(path,corner_ns[cur][i]);
        return;
      }
    }
  }
}


func walk_all(prv:i32,cur:i32){
  if (prv == -1 && cur == -1){
    for (i := 0; i < sites.length(); i++){
      if (weights[i] <= 1.0) continue;
      if (assign[i].length()) continue;
      for (j := 0; j < celli[i].length(); j++){
        if (celli[i][j] < 0) continue;
        if (visited[celli[i][j]]) continue;
        assign[i].push(celli[i][j]);
        walk_all(-2 - i, celli[i][j]);
        return;
      }
    }
    for (i := 0; i < visited.length(); i++){
      if (!visited[i]){
        walk_all(-1,i)
        return;
      }
    }
    return;
  }
  path := list[i32]{}
  if (prv != -1){
    path.push(prv);
  }
  walk(path,cur);
  if (path.length()>1){
    paths.push(path);
  }
  for (k := 0; k < paths.length(); k++){
    for (i := 1; i < paths[k].length()-1; i++){
      for (j := 0; j < corner_ns[paths[k][i]].length(); j++){
        if (!visited[corner_ns[paths[k][i]][j]]){
          visited[paths[k][i]] ++;
          walk_all(paths[k][i],corner_ns[paths[k][i]][j]);
          return;
        }
      }
    }
  }
  walk_all(-1,-1);
}

func relax(clipshape:list[list[vec[f32,2]]]){
  cs := geom.voronoi(corner_xs);
  for (i := 0; i < cs.length(); i++){
    bad := 0;
    for (j := 0; j < cs[i].length(); j++){
      if (!pt_in_clipshape(cs[i][j],clipshape)){
        bad = 1;
        break;
      }
    }
    if (bad) continue;
    c := centroid(cs[i]);

    f := (c - corner_xs[i])*0.5;
    for (j := 0; j < corner_ss[i].length(); j++){
      si := corner_ss[i][j];
      d := (corner_xs[i]-sites[si]) * (weights[si]-1.0) * 0.1;
      f += d;
    }
    corner_xs[i] += f;
  }
}


func plan_bud(idx0:i32,idx1:i32):i32{
  if (idx1 < -1){
    return -1;
  }
  if (visited[idx1] > 1){
    return -1;
  }
  p0 := {0.0,0.0};
  if (idx0 < -1){
    p0 = sites[-idx0-2];
  }else{
    p0 = corner_xs[idx0];
  }
  p1 := corner_xs[idx1];
  ma := 0.0;
  mi := -1;
  for (j := 0; j < corner_ss[idx1].length(); j++){
    si := corner_ss[idx1][j];
    if (assign[si].length()) continue;
    p2 := sites[si];
    ang := math.abs(calc_turn(p0,p1,p2));
    area := math.abs(poly_area(cells[si]));
    // io.println(ang);
    if (area > ma && ang < math.PI/2.0){
      mi = si;
      ma = area;
    }
  }
  if (mi < 0) return mi;
  assign[mi].push(idx1);
  return mi;
}


func make_petal(q0:vec[f32,2],q1:vec[f32,2],e:vec[f32,2]):list[vec[f32,2]]{
  pms := list[f32]{};
  cl := list[vec[f32,2]]{
    q0,
    q0*0.7 + q1*0.3 + e*1.2,
    q1 + e,
    q0*0.1 + q1*0.9 + e*0.3
  }
  cm := list[vec[f32,2]]{
    q0*0.1 + q1*0.9 + e*0.3,
    q1 + e*0.1,
    q1 - e*0.1,
    q0*0.1 + q1*0.9 - e*0.3,
  }
  cr := list[vec[f32,2]]{
    q0*0.1 + q1*0.9 - e*0.3,
    q1 - e,
    q0*0.7 + q1*0.3 - e*1.2,
    q0,
  }
  pts := list[vec[f32,2]]{};
  
  for (t := 0.0; t < 1.0; t += 0.05){
    v := geom.curve[2](cl, pms, t, geom.TYPE_BEZIER | geom.ORD_CUBIC);
    pts.push(v);
  }
  for (t := 0.0; t < 1.0; t += 0.05){
    v := geom.curve[2](cm, pms, t, geom.TYPE_BEZIER | geom.ORD_CUBIC);
    pts.push(v);
  }
  for (t := 0.0; t < 1.0; t += 0.05){
    v := geom.curve[2](cr, pms, t, geom.TYPE_BEZIER | geom.ORD_CUBIC);
    pts.push(v);
  }
  return pts;
}


func make_leaf01(leaves:list[list[vec[f32,2]]],veins:list[list[vec[f32,2]]],i:i32){
  p0 := corner_xs[assign[i][0]];
  p1 := corner_xs[assign[i][1]];
  p2 := sites[i];
  p3 := cells[i][assign[i][2]];
  

  d := (p1-p0)*0.5;
  q0 := (p0+p1)*0.5;
  q1 := (q0 + p2)*0.5;
  q2 := p2;
  q3 := (p2 + p3)*0.5;

  l := (p3-q0).mag();
  if (d.mag() <  l*0.15){
    d = d.dir()*l*0.15;
  }
  d *= 1.3;

  pts0 := list[vec[f32,2]]{};
  pts1 := list[vec[f32,2]]{};

  pms := list[f32]{};
  cl := list[vec[f32,2]]{
    q0, q1-d, q2-d*0.65, q3
  }
  cr := list[vec[f32,2]]{
    q3, q2+d*0.65, q1+d, q0
  }
  for (t := 0.0; t <= 1.0; t += 0.05){
    v := geom.curve[2](cl, pms, t, geom.TYPE_BEZIER | geom.ORD_CUBIC);
    pts0.push(v);
  }
  for (t := 0.0; t <= 1.0; t += 0.05){
    v := geom.curve[2](cr, pms, t, geom.TYPE_BEZIER | geom.ORD_CUBIC);
    pts0.push(v);
  }
  for (i := 0; i < pts0.length()*0.42; i++){
    v0 := pts0[i];
    v1 := pts0[pts0.length()-1-i];
    pts1.push(v0*0.6+v1*0.4);
  }
  
  larea := math.abs(poly_area(pts0));
  for (i := 3; i < pts1.length()-3; i+=3){
    t := (i as f32) / pts1.length();
    t = t*0.7 + 0.3;
    j : i32 = pts0.length()*0.5 * t;
    pts2 := list[vec[f32,2]]{};
    
    pts2.push(pts1[i]);
    if (((i-3)/3) & 1){
      pts2.push(pts0[j]*0.7 + pts1[i]*0.3);
    }else{
      pts2.push(pts0[pts0.length()-1-j]*0.7 + pts1[i]*0.3);
    }
    if (larea > 400){
      veins.push(pts2);
    }
  }
  if (larea > 100){
    veins.push(pts1);
  }
  leaves.push(pts0);
}



func make_leaf02(leaves:list[list[vec[f32,2]]],veins:list[list[vec[f32,2]]],i:i32){
  p0 := corner_xs[assign[i][0]];
  p1 := corner_xs[assign[i][1]];
  p2 := sites[i];
  p3 := cells[i][assign[i][2]];
  

  d := (p1-p0)*0.5;
  q0 := (p0+p1)*0.5;
  q1 := (q0 + p2)*0.5;
  q2 := p2;
  q3 := p2*0.3 + p3*0.7;

  l := (p3-q0).mag();
  if (d.mag() <  l*0.15){
    d = d.dir()*l*0.15;
  }
  d *= 1.3;

  pts0 := list[vec[f32,2]]{};
  pts1 := list[vec[f32,2]]{};
  pts3 := list[vec[f32,2]]{};

  pms := list[f32]{};
  cl := list[vec[f32,2]]{
    q0, q1-d, q2-d*0.65, q3
  }
  cr := list[vec[f32,2]]{
    q3, q2+d*0.65, q1+d, q0
  }
  for (t := 0.0; t <= 1.0; t += 0.05){
    v := geom.curve[2](cl, pms, t, geom.TYPE_BEZIER | geom.ORD_CUBIC);
    pts0.push(v);
  }
  for (t := 0.0; t <= 1.0; t += 0.05){
    v := geom.curve[2](cr, pms, t, geom.TYPE_BEZIER | geom.ORD_CUBIC);
    pts0.push(v);
  }
  for (i := 0; i < pts0.length()*0.35; i++){
    v0 := pts0[i];
    v1 := pts0[pts0.length()-1-i];
    pts1.push(v0*0.6+v1*0.4);
  }
  for (i := 0; i < pts0.length(); i++){
    v0 := pts0[i];
    ii := (i<pts0.length()/2) ? i : pts0.length()-1-i;
    j : i32 = (ii as f32)/ (pts0.length()*0.5) * pts1.length();
    v1 := pts1[j];
    t := math.sin(i*8)*0.2+1.2;
    pts3.push(v1*(1-t)+v0*t);
  }

  larea := math.abs(poly_area(pts0));
  for (i := 3; i < pts1.length()-3; i+=3){
    t := (i as f32) / pts1.length();
    t = t*0.7 + 0.3;
    j : i32 = pts0.length()*0.5 * t;
    pts2 := list[vec[f32,2]]{};
    
    pts2.push(pts1[i]);
    if (((i-3)/3) & 1){
      pts2.push(pts0[j]*0.7 + pts1[i]*0.3);
    }else{
      pts2.push(pts0[pts0.length()-1-j]*0.7 + pts1[i]*0.3);
    }
    if (larea > 200){
      veins.push(pts2);
    }
  }
  if (larea > 100){
    veins.push(pts1);
  }
  leaves.push(pts3);
}



func make_leaf03(leaves:list[list[vec[f32,2]]],veins:list[list[vec[f32,2]]],i:i32){
  p0 := corner_xs[assign[i][0]];
  p1 := corner_xs[assign[i][1]];
  p2 := sites[i];
  p3 := cells[i][assign[i][2]];



  d := (p1-p0)*0.5;
  q0 := (p0+p1)*0.5;
  q1 := (q0 + p2)*0.5;
  q2 := p2;
  q3 := p2*0.3 + p3*0.7;

  e := (q3-q0);
  f := {-e.y,e.x}.dir();
  q4 := ray_polygon(q2,q2+f,cells[i]);
  q5 := ray_polygon(q2,q2-f,cells[i]);

  q4 = q4-f*3;
  q5 = q5+f*3;

  q6 := (q4 + q0 + q2 + q0)/4.0
  q7 := (q5 + q0 + q2 + q0)/4.0

  q8 := (p0 + q0)*0.5;
  q9 := (p1 + q0)*0.5;

  l := (p3-q0).mag();
  if (d.mag() <  l*0.15){
    d = d.dir()*l*0.15;
  }
  d *= 1.3;

  pts0 := list[vec[f32,2]]{
    // q8,q4,q6,q3,q7,q5,q9
  };

  func bul(p0:vec[f32,2],p1:vec[f32,2],t:f32):vec[f32,2]{
    d := p1-p0;
    return p0 * (1-t) + p1 * t + {-d.y,d.x}*0.15
  }
  pms := list[f32]{};
  cs := list[list[vec[f32,2]]]{
    list[vec[f32,2]]{q0,q8,bul(q8,q4,0.5),q4},
    list[vec[f32,2]]{q4,bul(q4,q6,0.3),bul(q4,q6,0.6),q6},
    list[vec[f32,2]]{q6,bul(q6,q3,0.3),bul(q6,q3,0.6),q3},
    list[vec[f32,2]]{q3,bul(q3,q7,0.3),bul(q3,q7,0.6),q7},
    list[vec[f32,2]]{q7,bul(q7,q5,0.3),bul(q7,q5,0.6),q5},
    list[vec[f32,2]]{q5,bul(q5,q9,0.5),q9,q0},
  }

  for (i := 0; i < cs.length(); i++){
    for (t := 0.0; t <= 1.0; t += 0.05){
      v := geom.curve[2](cs[i], pms, t, geom.TYPE_BEZIER | geom.ORD_CUBIC);
      pts0.push(v);
    }
  }

  leaves.push(pts0);
}

func make_bud01(buds:list[list[vec[f32,2]]],flowers:list[list[vec[f32,2]]],i:i32){
  p0 := corner_xs[paths[i][paths[i].length()-1]];
  p1 := sites[ends[i]];
  th := math.atan2(...((p1-p0).yx));
  costh := math.cos(th);
  sinth := math.sin(th);

  n := 20;
  ps := list[vec[f32,2]]{};
  
  for (j := 0; j < n; j++){
    a := (j as f32)/n * math.PI * 2;
    x := (math.cos(a) * 16*0.5 + 2) *0.9;
    y := (math.sin(a) * 14*0.5 + 0) *0.9;
    x1 := x * costh - y * sinth + sites[ends[i]].x;
    y1 := x * sinth + y * costh + sites[ends[i]].y;
    ps.push({x1,y1});
  }
  buds.push(ps);

  ps = list[vec[f32,2]]{};
  for (j := 0; j < n; j++){
    a := (j as f32)/n * math.PI * 2;
    x := (math.cos(a) * 20*0.5 + 4) *0.9;
    y := (math.sin(a) * 14*0.5 - 2) *0.9;
    x1 := x * costh - y * sinth + sites[ends[i]].x;
    y1 := x * sinth + y * costh + sites[ends[i]].y;
    ps.push({x1,y1});
  }
  buds.push(ps);
}

func make_bud02(buds:list[list[vec[f32,2]]],flowers:list[list[vec[f32,2]]],i:i32){
  p0 := corner_xs[paths[i][paths[i].length()-1]];
  p1 := sites[ends[i]];

  d := (p1-p0)*0.3;
  e := {-d.y,d.x}*1.5;
  cl := list[vec[f32,2]]{
    p0, p0+d-e, p0+d
  }
  cr := list[vec[f32,2]]{
    p0+d, p0+d+e, p0
  }
  pms := list[f32]{};
  pts := list[vec[f32,2]]{};
  for (t := 0.0; t < 1.0; t += 0.05){
    v := geom.curve[2](cl, pms, t, geom.TYPE_BEZIER | geom.ORD_QUADRATIC);
    pts.push(v);
  }
  for (t := 0.0; t < 1.0; t += 0.05){
    v := geom.curve[2](cr, pms, t, geom.TYPE_BEZIER | geom.ORD_QUADRATIC);
    pts.push(v);
  }
  buds.push(pts);

  for (i := 0; i < 3; i++){
    d := p1-p0;
    th := (i-1)*0.35;
    costh := math.cos(th);
    sinth := math.sin(th);
    x1 := d.x * costh - d.y * sinth;
    y1 := d.x * sinth + d.y * costh;
    d = {x1,y1};
    q1 := p0+d;
    e := {-d.y,d.x};
    e = e.dir();
    flowers.push(make_petal(p0,q1,e*3.0));
  }

}


func make_bud03(buds:list[list[vec[f32,2]]],flowers:list[list[vec[f32,2]]],i:i32){
  p0 := corner_xs[paths[i][paths[i].length()-1]];
  p1 := sites[ends[i]];
  th := math.atan2(...((p1-p0).yx));
  costh := math.cos(th);
  sinth := math.sin(th);

  n := 20;
  ps := list[vec[f32,2]]{};
  
  for (j := 0; j < n; j++){
    a := (j as f32)/n * math.PI * 2;
    x := (math.cos(a) * 16*0.5 + 0);
    y := (math.sin(a) * 14*0.5 + 0);
    x1 := x * costh - y * sinth + sites[ends[i]].x;
    y1 := x * sinth + y * costh + sites[ends[i]].y;
    ps.push({x1,y1});
  }
  flowers.push(ps);

  pms := list[f32]{};
  for (i := 0; i < 2; i++){
    pts0 := list[vec[f32,2]]{};
    e := p1 - p0;
    e = {-e.y,e.x}.dir()*20.0;
    q0 := p1 - (p1-p0).dir()*15;

    q3 := p1 + e * (i-0.5);

    q1 := q0*0.7+q3*0.3;
    q2 := q0*0.3+q3*0.7;
    
    d := q3-q0;
    d = {-d.y,d.x}*0.25
    cl := list[vec[f32,2]]{
      q0, q1-d, q2-d*0.65, q3
    }
    cr := list[vec[f32,2]]{
      q3, q2+d*0.65, q1+d, q0
    }
    for (t := 0.0; t <= 1.0; t += 0.05){
      v := geom.curve[2](cl, pms, t, geom.TYPE_BEZIER | geom.ORD_CUBIC);
      pts0.push(v);
    }
    for (t := 0.0; t <= 1.0; t += 0.05){
      v := geom.curve[2](cr, pms, t, geom.TYPE_BEZIER | geom.ORD_CUBIC);
      pts0.push(v);
    }
    buds.push(pts0);
  }


}


func make_flower01(flowers:list[list[vec[f32,2]]],ci:i32,si:i32){
  p0 := corner_xs[ci];
  p1 := sites[si];
  dp := p1 - p0;
  ep := {-dp.y,dp.x};
  q0 := p0*0.7+p1*0.3;

  n := 32;
  vs := list[vec[f32,2]]{}

  sz := dp.mag();

  ang0 := math.atan2(dp.y,dp.x);

  for (i := 0; i < n; i++){
    ang := ((i / ((n-1) as f32))-0.5) * (math.PI) + ang0;
    q1 := q0 + {
      math.cos(ang),
      math.sin(ang)
    }
    q2 := ray_polygon(q0,q1,cells[si]);
    l := (q2-q0).mag();

    if (l > sz*1.0){
      vs.push(q2);
    }
  }
  if (vs.length()>2) vs = vs.slice(1,vs.length()-1);
  idcs := list[i32]{};
  for (i := 0; i < vs.length(); i++) idcs.push(i);
  shuffle(idcs);

  nn := vs.length();
  if (nn > 8) nn = 8;
  for (i := 0; i < nn; i++){
    idx := idcs[i];
    t := (idx as f32) / (vs.length()-1);
    ti := (i as f32) / nn;

    sh := 0.1;
    if (i > nn/2){
      sh = 0.3
    }
    q1 := (vs[idx]-q0)*(1.0-sh-ti*0.1)+q0;
    d := q1-q0;
    e := {-d.y,d.x};
    
    if (i == nn/2){
      
      for (j := 0; j < 8; j++){
        a1 := rand.random(0.0,math.PI*2);
        r1 := rand.random(0.0,sz*0.4);
        og := p1 + {
          math.cos(a1)*r1,
          math.sin(a1)*r1
        }
        a2 := math.atan2(...(og.yx-q0.yx))
        pts := list[vec[f32,2]]{
          q0
        };
        for (k := 0; k < 10; k++){
          a := (k/9.0-0.5) * math.PI*1.6 + a2
          pts.push({
            math.cos(a)*3
            math.sin(a)*3
          }+og)
        }
        pts.push(q0);
        flowers.push(pts);
      }
      
    }

    w := math.sin(t*math.PI);
    e = e.dir() * sz * (w * 0.1 + 0.2);

    flowers.push(make_petal(q0,q1,e));
  }

}


func make_flower02(flowers:list[list[vec[f32,2]]],ci:i32,si:i32){
  p0 := corner_xs[ci];
  p1 := sites[si];
  dp := p1 - p0;
  ep := {-dp.y,dp.x};
  q0 := p0*0.1+p1*0.9;

  n := 12;
  vs := list[vec[f32,2]]{}

  sz := dp.mag();

  ang0 := math.atan2(dp.y,dp.x);

  avgl := 0.0;
  for (i := 0; i < n; i++){
    ang := ((i / ((n-1) as f32))) * (math.PI*2) + rand.random(-0.05,0.05);
    q1 := q0 + {
      math.cos(ang),
      math.sin(ang)
    }
    q2 := ray_polygon(q0,q1,cells[si]);
    l := (q2-q0).mag();

    if (l > sz*0.5){
      avgl += l;
      vs.push(q2);
    }
  }
  avgl /= vs.length();

  idcs := list[i32]{};
  for (i := 0; i < vs.length(); i++) idcs.push(i);
  shuffle(idcs);

  nn := vs.length();
  if (nn > 12) nn = 12;
  for (i := 0; i < nn; i++){
    idx := idcs[i];
    t := (idx as f32) / (vs.length()-1);
    ti := (i as f32) / nn;

    q1 := vs[idx]-q0;
    l := q1.mag() * 0.5 + avgl * 0.3;
    q1 = q1.dir() * l + q0;
    d := q1-q0;
    e := {-d.y,d.x};
    
    e = e.dir() * avgl*0.13;

    flowers.push(make_petal(q0,q1,e));

    if (i == nn-1){
      
      for (j := 0; j < 12; j++){
        a1 := rand.random(0.0,math.PI*2);
        r1 := rand.random(0.0,sz*0.3);
        og := p1 + {
          math.cos(a1)*r1,
          math.sin(a1)*r1
        }
        a2 := math.atan2(...(og.yx-q0.yx))
        pts := list[vec[f32,2]]{
          q0
        };
        for (k := 0; k < 10; k++){
          a := (k/9.0-0.5) * math.PI*1.6 + a2
          pts.push({
            math.cos(a)*3
            math.sin(a)*3
          }+og)
        }
        pts.push(q0);
        flowers.push(pts);
      }
      
    }


  }
}


func make_flower03(flowers:list[list[vec[f32,2]]],ci:i32,si:i32){
  p0 := corner_xs[ci];
  p1 := sites[si];
  dp := p1 - p0;
  ep := {-dp.y,dp.x};
  q0 := p0*0.1+p1*0.9;

  n := 12;
  vs := list[vec[f32,2]]{}

  sz := dp.mag();

  ang0 := math.atan2(dp.y,dp.x);

  avgl := 0.0;
  for (i := 0; i < n; i++){
    ang := ((i / ((n-1) as f32))) * (math.PI*2) + rand.random(-0.05,0.05);
    q1 := q0 + {
      math.cos(ang),
      math.sin(ang)
    }
    q2 := ray_polygon(q0,q1,cells[si]);
    l := (q2-q0).mag();

    if (l > sz*0.5){
      avgl += l;
      vs.push(q2);
    }
  }
  avgl /= vs.length();

  idcs := list[i32]{};
  for (i := 0; i < vs.length(); i++) idcs.push(i);
  shuffle(idcs);

  nn := vs.length();
  if (nn > 12) nn = 12;
  for (i := 0; i < nn; i++){
    idx := idcs[i];
    t := (idx as f32) / (vs.length()-1);
    ti := (i as f32) / nn;

    q1 := vs[idx]-q0;
    l := (q1.mag() * 0.5 + avgl * 0.4) * ((1-ti)*0.5+0.5);
    q1 = q1.dir() * l + q0;
    d := q1-q0;
    e := {-d.y,d.x};
    
    e = e.dir() * l*0.4;

    flowers.push(make_petal(q0,q1,e));

    if (i == nn-1){
      
      for (j := 0; j < 12; j++){
        a1 := rand.random(0.0,math.PI*2);
        r1 := rand.random(0.0,sz*0.3);
        og := p1 + {
          math.cos(a1)*r1,
          math.sin(a1)*r1
        }
        a2 := math.atan2(...(og.yx-q0.yx))
        pts := list[vec[f32,2]]{
          q0
        };
        for (k := 0; k < 10; k++){
          a := (k/9.0-0.5) * math.PI*1.6 + a2
          pts.push({
            math.cos(a)*3
            math.sin(a)*3
          }+og)
        }
        pts.push(q0);
        flowers.push(pts);
      }
      
    }


  }
}


func process(clipshape:list[list[vec[f32,2]]]):tup[
  list[list[vec[f32,2]]],
  list[list[vec[f32,2]]],
  list[list[vec[f32,2]]],
  list[list[vec[f32,2]]],
  list[list[vec[f32,2]]]
]{
  
  
  n_samp : i32 = 200;
  n_big : i32 = n_samp * 0.1;
  n_lil : i32 = n_samp - n_big;
  
  weights = list[f32]{};
  for (i := 0; i < n_big; i++){
    weights.push(2.0);
  }
  for (i := 0; i < n_lil; i++){
    weights.push(1.0);
  }
  sites = poisson_sample(weights);
  for (i := sites.length()-1; i>=0; i--){
    if (!pt_in_clipshape(sites[i],clipshape)){
      sites.erase(i,i+1);
      weights.erase(i,i+1);
    }
  }

  cells = geom.voronoi(sites);
  celli = list[list[i32]]{};
  exempt := list[vec[f32,2]]{};
  for (i := 0; i < cells.length(); i++){
    [hull, mask] := convexclip(cells[i],clipshape);
    nin := mask.filter(func(x:i32):i32{return x!=-1}).length();
    if (nin == 0){
      for (j := 0; j < mask.length(); j++){
        mask[j] = 0;
      }
    }
    for (j := 0; j < mask.length(); j++){
      if (mask[j] != -1) continue;
      for (k := 0; k < exempt.length(); k++){
        if ((exempt[k]-hull[j]).mag() < 0.0001){
          mask[j] = 0;
        }
      }
    }
    cells[i] = hull;
    celli.push(mask);
  }

  corner_xs = list[vec[f32,2]]{};
  corner_ns = list[list[i32]]{};
  corner_ss = list[list[i32]]{};
  corner_qs = list[list[i32]]{};
  
  for (i := 0; i < cells.length(); i++){  
    if (!cells[i].length()) continue;
    idx0 := find_corner(i, cells[i].length()-1);
    for (j := 0; j < cells[i].length(); j++){
      idx1 := find_corner(i,j);
      celli[i][j] = idx1;
      if (idx1 > 0) corner_ss[idx1].push(i);
      add_edge(corner_ns,idx0,idx1);
      add_edge(corner_ns,idx1,idx0);
      idx0 = idx1;
    }
  }
  visited = list[i32]{};
  for (i := 0; i < corner_xs.length(); i++) visited.push(0)
  paths = list[list[i32]]{};


  relax(clipshape);
  relax(clipshape);
  relax(clipshape);

  for (i := 0; i < sites.length(); i++){
    for (j := 0; j < celli[i].length(); j++){
      idx := celli[i][j];
      if (idx >= 0){
        cells[i][j] = corner_xs[idx];
      }
    }
  }

  for (i := 0; i < sites.length(); i++){
    sites[i] = centroid(cells[i]);
  }

  assign := list[list[i32]]{};
  for (i := 0; i < sites.length(); i++){
    assign.push(list[i32]{});
  }

  walk_all(-1,-1);


  for (i := 0; i < paths.length(); i++){
    for (j := 0; j < paths[i].length()-1; j++){

      add_edge(corner_qs, paths[i][j],paths[i][j+1]);
      add_edge(corner_qs, paths[i][j+1],paths[i][j]);
    }
  }

  ends := list[i32]{}

  for (i := 0; i < paths.length(); i++){
    e := paths[i][paths[i].length()-1];

    if (e >= 0){
      for (k := 0; k < corner_ss[e].length(); k++){
        si := corner_ss[e][k];
        if (weights[si] > 1.0 && assign[si].length()==0){
          paths[i].push(-2-si);
          assign[si].push(e);
          break;
        }
      }
    }
    ends.push(
      plan_bud(paths[i][paths[i].length()-2], paths[i][paths[i].length()-1])
    )
  }
  

  buds := list[list[vec[f32,2]]]{};
  flowers := list[list[vec[f32,2]]]{};

  for (i := 0; i < ends.length(); i++){
    if (ends[i]<0) continue;

    if (preset == 1){
      make_bud01(buds,flowers,i);
    }else if (preset == 2){
      make_bud02(buds,flowers,i);
    }else if (preset == 3){
      make_bud03(buds,flowers,i);
    }
  }


  for (i := 0; i < celli.length(); i++){
    if (assign[i].length()) continue;
    md := 0.0;
    m0 := -1;
    m1 := -1;
    m2 := -1;
    for (j := 0; j < celli[i].length(); j++){
      a := celli[i][j];
      b := celli[i][(j+1)%celli[i].length()];
      if (a == -1 || b == -1) continue;
      ok := 0;
      for (k := 0; k < corner_qs[a].length(); k++){
        if (corner_qs[a][k] == b){
          ok = 1;
          break;
        }
      }
      if (!ok) continue;

      p0 := corner_xs[a];
      p1 := corner_xs[b];

      dd := 0.0;
      dk := -1;
      for (k := 0; k < cells[i].length(); k++){
        if (k == j) continue;
        if (k == (j+1)%cells[i].length()) continue;
        p2 := cells[i][k];
        d := dist_pt_to_ln(...p2, ...p0,...p1);
        if (d > dd){
          dd = d;
          dk = k;
        }
      }
      if (dk >= 0 && dd > md){
        md = dd;
        m0 = a;
        m1 = b;
        m2 = dk;
      }
    }
    if (m0 >= 0){
      assign[i].push(m0);
      assign[i].push(m1);
      assign[i].push(m2);
    }
  }


  vines := list[list[vec[f32,2]]]{};
  for (i := 0; i < paths.length(); i++){
    pts := list[vec[f32,2]]{}
    for (j := 0; j < paths[i].length(); j++){
      q := paths[i][j];
      if (q < -1){
        pts.push(sites[-q-2])
      }else{
        pts.push(corner_xs[q])
      }
    }
    if (ends[i] >= 0){
      pts.push(sites[ends[i]]);
    }
    vines.push(smoothen(pts));
  }

  leaves := list[list[vec[f32,2]]]{};
  veins := list[list[vec[f32,2]]]{};

  for (i := 0; i < assign.length(); i++){
    if (assign[i].length() != 3) continue;
    if (preset == 1){
      make_leaf01(leaves,veins,i);
    }else if (preset == 2){
      make_leaf02(leaves,veins,i);
    }else if (preset == 3){
      make_leaf03(leaves,veins,i);
    }
  }


  for (i := 0; i < paths.length(); i++){
    for (j := 0; j < paths[i].length(); j++){
      if (paths[i][j] < -1){
        j1 := j+1;
        if (j) j1 = j-1;
        if (preset == 1){
          make_flower01(flowers,paths[i][j1],-paths[i][j]-2);
        }else if (preset == 2){
          make_flower02(flowers,paths[i][j1],-paths[i][j]-2);
        }else if (preset == 3){
          make_flower03(flowers,paths[i][j1],-paths[i][j]-2);
        }
      }
    }
  }

  for (i := 0; i < assign.length(); i++){
    if (assign[i].length()) continue;
    d := rand.random({-1.0,-1.0},{1.0,1.0}).dir()*8.0;

    flowers.push(make_petal(sites[i]-d,sites[i]+d,{-d.y,d.x}/1.5));
  }


  return [vines,leaves,veins,flowers,buds];

}


func render(
  vines:list[list[vec[f32,2]]],
  leaves:list[list[vec[f32,2]]],
  veins:list[list[vec[f32,2]]],
  flowers:list[list[vec[f32,2]]],
  buds:list[list[vec[f32,2]]],
){
  // drw.background(0,0,0,0.1);
  drw.background(0);
  drw.fill(...color1);
  drw.stroke(...color0);
  drw.stroke_weight(1.5);

  for (i := 0; i < leaves.length(); i++){
    drw.begin_shape();
    for (j := 0; j < leaves[i].length(); j++){
      drw.vertex(...leaves[i][j]);
    }
    drw.end_shape(1);
  }
  drw.stroke(...color0);
  drw.stroke_weight(1.5);
  drw.no_fill();
  for (i := 0; i < veins.length(); i++){
    drw.begin_shape();
    for (j := 0; j < veins[i].length(); j++){
      drw.vertex(...veins[i][j])
    }
    drw.end_shape();
  }
  drw.no_fill();
  drw.stroke(...color0)
  drw.stroke_weight(6);
  for (k := 0; k < vines.length(); k++){
    drw.begin_shape();
    for (i := 0; i < vines[k].length(); i++){
      drw.vertex(...vines[k][i])
    }
    drw.end_shape();
  } 
  drw.stroke(...color2)
  drw.stroke_weight(3);
  for (k := 0; k < vines.length(); k++){
    drw.begin_shape();
    for (i := 0; i < vines[k].length(); i++){
      drw.vertex(...vines[k][i])
    }
    drw.end_shape();
  }

  drw.stroke(...color0);
  drw.stroke_weight(1.5);
  drw.fill(...color3);
  for (i := 0; i < flowers.length(); i++){
    drw.begin_shape();
    for (j := 0; j < flowers[i].length(); j++){
      drw.vertex(...flowers[i][j])
    }
    drw.end_shape();
  }

  drw.fill(...color1);
  drw.stroke(...color0);
  drw.stroke_weight(1.5);
  for (i := 0; i < buds.length(); i++){
    drw.begin_shape();
    for (j := 0; j < buds[i].length(); j++){
      drw.vertex(...buds[i][j]);
    }
    drw.end_shape(1);
  }
}


clipshape := list[list[vec[f32,2]]]{
  list[vec[f32,2]]{
    {0,0},{W,0},{W,H},{0,H}
  }
};


frame := 0;

drw.size(W*3+200,H+100);

rand.seed(0x5EED)
drawdat := process(clipshape);
pg1 := drw.create_graphics(W,H);
pg1.begin();
render(...drawdat);
pg1.end();

rand.seed(0x5EED)
preset = 2;
color3 = {1.0,0.8,0.4}
color1 = {0.6,0.7,0.5};
drawdat = process(clipshape);
pg2 := drw.create_graphics(W,H);
pg2.begin();
render(...drawdat);
pg2.end();


rand.seed(0x5EED)
preset = 3;
color3 = {1.0,0.7,0.8}
color1 = {0.6,0.9,0.8};
drawdat = process(clipshape);
pg3 := drw.create_graphics(W,H);
pg3.begin();
render(...drawdat);
pg3.end();

while (1){
  drw.background(0.0);
  
  pg1.draw(50,50);
  pg2.draw(100+W,50);
  pg3.draw(150+W*2,50);

  drw.poll();

}
