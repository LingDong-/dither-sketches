include "std/win"
include "std/math"
include "std/list"
include "std/geom"
include "std/drw"
include "std/io"
include "std/vec"

func natural_cubic_bezier(points:list[vec[f32,2]]):list[list[vec[f32,2]]]{
  n := points.length() - 1;
  if (n < 1) return list[list[vec[f32,2]]]{};
  if (n == 1) {
    p0 := points[0];
    p3 := points[1];
    c1 := p0 + (p3-p0)*(1.0/3.0);
    c2 := p0 + (p3-p0)*(2.0/3.0);
    return list[list[vec[f32,2]]]{list[vec[f32,2]]{p0, c1, c2, p3}};
  }
  func solve(rhs:list[f32]):list[f32]{
    m := rhs.length();
    x   := rhs.map(func(v:f32):f32{return 0.0});
    tmp := rhs.map(func(v:f32):f32{return 0.0});
    b := 2.0;
    x[0] = rhs[0] / b;
    for (i := 1; i < m; i++) {
      tmp[i] = 1.0 / b;
      b = ((i < m - 1) ? 4.0 : 3.5) - tmp[i];
      x[i] = (rhs[i] - x[i-1]) / b;
    }
    for (i := 1; i < m; i++) {
      x[m-1-i] -= tmp[m-i] * x[m-i];
    }
    return x;
  }
  func control_points_1d(K:list[f32]):list[f32]{
    m := K.length() - 1;
    rhs := list[f32]{};
    rhs.push(K[0] + 2*K[1]);
    for (i := 1; i < m - 1; i++) rhs.push(4.0*K[i] + 2.0*K[i+1]);
    rhs.push((8.0*K[m-1] + K[m]) / 2.0);
    return solve(rhs);
  }
  X := points.map(func(p:vec[f32,2]):f32{return p.x});
  Y := points.map(func(p:vec[f32,2]):f32{return p.y});

  p1x := control_points_1d(X);
  p1y := control_points_1d(Y);

  segments := list[list[vec[f32,2]]]{};
  for (i := 0; i < n; i++) {
    p0 := points[i];
    p3 := points[i+1];
    c1 := {p1x[i], p1y[i]};
    c2 := {0.0,0.0};
    if (i < n - 1) {
      c2 = {2*X[i+1] - p1x[i+1], 2*Y[i+1] - p1y[i+1]};
    } else {
      c2 = {(X[n] + p1x[n-1]) / 2, (Y[n] + p1y[n-1]) / 2};
    }
    segments.push(list[vec[f32,2]]{p0, c1, c2, p3});
  }
  return segments;
}

func build_curve(segs:list[list[vec[f32,2]]],reso:f32):list[vec[f32,2]]{
  curv := list[vec[f32,2]]{};
  for (i := 0; i < segs.length(); i++){
    for (t := 0.0; t < 1.0; t += reso){
      curv.push(geom.curve(segs[i],list[f32]{},t,geom.TYPE_BEZIER|geom.ORD_CUBIC));
    }
  }
  return curv;
}


func build_combs(segs:list[list[vec[f32,2]]],scale:f32,reso:f32):list[vec[f32,2]]{
  combs := list[vec[f32,2]]{};
  for (i := 0; i < segs.length(); i++){
    d1ps := list[vec[f32,2]]{
      segs[i][1]-segs[i][0],
      segs[i][2]-segs[i][1],
      segs[i][3]-segs[i][2],
    }
    d2ps := list[vec[f32,2]]{
      segs[i][2]-2*segs[i][1]+segs[i][0],
      segs[i][3]-2*segs[i][2]+segs[i][1],
    }
    for (t := 0.0; t < 1.0; t += reso){
      pt := geom.curve(segs[i],list[f32]{},t,geom.TYPE_BEZIER|geom.ORD_CUBIC);
      d1 := 3*geom.curve(d1ps,list[f32]{},t,geom.TYPE_BEZIER|geom.ORD_QUADRATIC);
      d2 := 6*(d2ps[0]*(1-t)+d2ps[1]*t);
      num := d1.x*d2.y - d1.y*d2.x;
      denom := (d1.x**2 + d1.y**2)**1.5;
      kappa := num / denom;
      T := d1 / d1.mag();
      N := {-T.y,T.x};
      combs.push(pt)
      combs.push(pt-scale*kappa*N);
    }
  }
  return combs;
}

inp := list[vec[f32,2]]{
  {20, 280},
  {160, 160},
  {340, 420},
  {520, 180},
  {580, 360}
}

segs := natural_cubic_bezier(inp);

reso := 0.01;
comb_size := 1000.0;
curv := build_curve(segs,reso);
combs := build_combs(segs,comb_size,reso*2);

drag := -1;

drw.size(640,480);

while (1){
  drw.background(0.0);


  drw.stroke_weight(1);
  drw.stroke(0.3);
  for (i := 0; i < combs.length(); i+=2){
    drw.line(...combs[i],...combs[i+1]);
  }

  drw.stroke(0.4,0.7,1.0);
  drw.fill(0);

  
  for (i := 0; i < segs.length(); i++){
    drw.line(...segs[i][0],...segs[i][1]);
    drw.line(...segs[i][2],...segs[i][3]);
    drw.ellipse(...segs[i][1],10,10);
    drw.ellipse(...segs[i][2],10,10);
  }

  drw.stroke(1.0);
  drw.stroke_weight(2);
  drw.no_fill();
  drw.begin_shape();
  for (i := 0; i < curv.length(); i++){
    drw.vertex(...curv[i]);
  }
  drw.end_shape();

  drw.fill(0);
  for (i : = 0; i < inp.length(); i++){
    drw.ellipse(...inp[i],10,10);
  }

  drw.fill(1);
  drw.text("Left click to add a point",0,16);
  drw.text("Right click to remove a point",0,32);
  drw.text("Drag on a point to move it",0,48);

  e := drw.poll();
  if (e.type == win.MOUSE_PRESSED){
    for (i := inp.length()-1; i>=0; i--){
      if ((inp[i]-{e.x,e.y}).mag() < 20){
        if (e.key == win.MOUSE_RIGHT){
          inp.erase(i,i+1);
          segs = natural_cubic_bezier(inp);
          curv = build_curve(segs,reso);
          combs = build_combs(segs,comb_size,reso*2);
          drag = -2;
        }else{
          drag = i;
        }
        break;
      }
    }
    if (drag == -1){
      inp.push({e.x,e.y});
      segs = natural_cubic_bezier(inp);
      curv = build_curve(segs,reso);
      combs = build_combs(segs,comb_size,reso*2);
    }
  }else if (e.type == win.MOUSE_MOVED){
    if (drag >= 0){
      inp[drag] = {e.x,e.y};
      segs = natural_cubic_bezier(inp);
      curv = build_curve(segs,reso);
      combs = build_combs(segs,comb_size,reso*2);
    }
  }else if (e.type == win.MOUSE_RELEASED){
    drag = -1;
  }
}